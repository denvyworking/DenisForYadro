{
  "info": {
    "name": "Log Parser API",
    "_postman_id": "7f4d2a1d-1f4e-4d2f-9f2a-1d4f0d7a5a91",
    "description": "Collection for the log parser service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Parse log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"path\": \"data/example.zip\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/parse/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "parse", ""]
        }
      },
      "response": []
    },
    {
      "name": "Get topology",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/topology/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "topology", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Get node",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/node/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "node", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Get ports",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/port/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "port", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Get log",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/log/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "log", "1"]
        }
      },
      "response": []
    }
  ]
}
